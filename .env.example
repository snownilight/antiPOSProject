# --- 預設的 Production 環境變數範例 ---
# 請複製此檔案並命名為 .env，然後修改為實際的生產環境設定

# Spring Boot 環境設定
SPRING_PROFILES_ACTIVE=prod

# Database 資料庫設定 (適用於 docker-compose 或實體機)
DB_HOST=db
DB_PORT=3306
DB_NAME=antipos
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT 驗證金鑰 (POS-54 Security)
# 請替換為您自己的 Base64 編碼金鑰 (至少 256 bits)
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough
JWT_EXPIRATION=86400000

# CORS 與 前端 URL 設定
# 請設定為實際生產環境的網域，例如 https://your-production-domain.com
CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
