<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.backend.mapper.ProductMapper">

    <resultMap id="productResultMap" type="com.project.backend.entity.Product">
        <id property="id" column="id" />
        <result property="categoryId" column="category_id" />
        <result property="name" column="name" />
        <result property="description" column="description" />
        <result property="price" column="price" />
        <result property="imageUrl" column="image_url" />
        <result property="status" column="status" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <collection property="modifierGroups" ofType="com.project.backend.entity.ModifierGroup" select="findModifierGroupsByProductId" column="id" />
    </resultMap>

    <resultMap id="modifierGroupResultMap" type="com.project.backend.entity.ModifierGroup">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="minSelection" column="min_selection" />
        <result property="maxSelection" column="max_selection" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <collection property="options" ofType="com.project.backend.entity.ModifierOption" select="findOptionsByGroupId" column="id" />
    </resultMap>

    <resultMap id="modifierOptionResultMap" type="com.project.backend.entity.ModifierOption">
        <id property="id" column="id" />
        <result property="groupId" column="group_id" />
        <result property="name" column="name" />
        <result property="priceModifier" column="price_modifier" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <collection property="modifierGroups" ofType="com.project.backend.entity.ModifierGroup" select="findModifierGroupsByOptionId" column="id" />
        <collection property="bundleItems" ofType="com.project.backend.entity.BundleItem" select="findBundleItemsByOptionId" column="id" />
    </resultMap>

    <resultMap id="bundleItemResultMap" type="com.project.backend.entity.BundleItem">
        <id property="id" column="id" />
        <result property="optionId" column="option_id" />
        <result property="name" column="name" />
        <result property="sortOrder" column="sort_order" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <collection property="modifierGroups" ofType="com.project.backend.entity.ModifierGroup" select="findModifierGroupsByBundleItemId" column="id" />
    </resultMap>


    <select id="findModifierGroupsByProductId" resultMap="modifierGroupResultMap">
        SELECT mg.* FROM modifier_group mg
        JOIN product_modifier_group pmg ON mg.id = pmg.group_id
        WHERE pmg.product_id = #{productId} AND mg.is_deleted = FALSE
    </select>

    <select id="findOptionsByGroupId" resultMap="modifierOptionResultMap">
        SELECT * FROM modifier_option 
        WHERE group_id = #{groupId} AND is_deleted = FALSE
        ORDER BY id ASC
    </select>

    <select id="findModifierGroupsByOptionId" resultMap="modifierGroupResultMap">
        SELECT mg.* FROM modifier_group mg
        JOIN option_modifier_group omg ON mg.id = omg.group_id
        WHERE omg.option_id = #{optionId} AND mg.is_deleted = FALSE
    </select>

    <select id="findBundleItemsByOptionId" resultMap="bundleItemResultMap">
        SELECT * FROM bundle_item
        WHERE option_id = #{optionId} AND is_deleted = FALSE
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findModifierGroupsByBundleItemId" resultMap="modifierGroupResultMap">
        SELECT mg.* FROM modifier_group mg
        JOIN bundle_item_modifier_group bimg ON mg.id = bimg.group_id
        WHERE bimg.bundle_item_id = #{bundleItemId} AND mg.is_deleted = FALSE
    </select>

    <select id="findAllActive" resultMap="productResultMap">
        SELECT * FROM product 
        WHERE is_deleted = FALSE 
        <if test="categoryId != null">
            AND category_id = #{categoryId}
        </if>
        ORDER BY category_id ASC, id ASC
    </select>

    <select id="findById" resultMap="productResultMap">
        SELECT * FROM product WHERE id = #{id} AND is_deleted = FALSE
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product (category_id, name, description, price, image_url, status)
        VALUES (#{categoryId}, #{name}, #{description}, #{price}, #{imageUrl}, #{status})
    </insert>

    <update id="update">
        UPDATE product
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="price != null">price = #{price},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id} AND is_deleted = FALSE
    </update>

    <update id="softDelete">
        UPDATE product SET is_deleted = TRUE WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE product SET status = #{status} WHERE id = #{id} AND is_deleted = FALSE
    </update>

</mapper>
