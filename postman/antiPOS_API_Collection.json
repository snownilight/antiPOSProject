{
  "info": {
    "name": "antiPOS API Collection",
    "description": "antiPOS 餐飲 POS 系統完整 API 測試集，涵蓋分類、商品、桌台管理的 CRUD 與邊緣條件測試。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Category（分類管理）",
      "item": [
        {
          "name": "正常流程",
          "item": [
            {
              "name": "取得所有分類",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/categories"
              }
            },
            {
              "name": "取得單筆分類",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/categories/1"
              }
            },
            {
              "name": "新增分類",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Postman 測試分類\",\n  \"sortOrder\": 50\n}"
                }
              }
            },
            {
              "name": "更新分類",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/categories/1",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"更新後的分類名稱\",\n  \"sortOrder\": 15\n}"
                }
              }
            },
            {
              "name": "刪除分類（軟刪除）",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/categories/1"
              }
            }
          ]
        },
        {
          "name": "邊緣條件",
          "item": [
            {
              "name": "❌ 空字串名稱 → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"\",\n  \"sortOrder\": 0\n}"
                }
              }
            },
            {
              "name": "❌ 缺少 name 欄位 → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sortOrder\": 0\n}"
                }
              }
            },
            {
              "name": "❌ 僅空白字串名稱 → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"   \",\n  \"sortOrder\": 0\n}"
                }
              }
            },
            {
              "name": "❌ 負數排序權重 → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"負數排序\",\n  \"sortOrder\": -1\n}"
                }
              }
            },
            {
              "name": "❌ 名稱超過 100 字元 → 400",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n  \"sortOrder\": 0\n}"
                }
              }
            },
            {
              "name": "❌ 查詢不存在的 ID → 500",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/categories/99999"
              }
            },
            {
              "name": "🔒 SQL Injection 測試",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"'; DROP TABLE category; --\",\n  \"sortOrder\": 0\n}"
                }
              }
            },
            {
              "name": "🔒 XSS 攻擊測試",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"<script>alert('xss')</script>\",\n  \"sortOrder\": 0\n}"
                }
              }
            },
            {
              "name": "🌐 中文 + Emoji 名稱",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/categories",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"🍜 拉麵（限定版）\",\n  \"sortOrder\": 0\n}"
                }
              }
            }
          ]
        }
      ]
    },
